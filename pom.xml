<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion> <!-- Versão do módulo POM -->

    <parent> <!-- Indica que esse projeto HERDA(Extends) configurações do Spring Boot -->
        <groupId>org.springframework.boot</groupId> <!-- Grupo do Spring boot -->
        <artifactId>spring-boot-starter-parent</artifactId> <!-- Pai que fornece configuração padrão -->
        <version>3.4.1</version> <!-- Informar versão do Spring Boot -->
        <relativePath/> <!-- Ignora repositório local -->
    </parent>

    <groupId>github.com.tiagoribeine</groupId> <!-- Convenção: geralmente é domínio reverso (com.tiagoribeine.github)-->
    <artifactId>rest-with-spring-boot-and-java-erudio</artifactId> <!-- Nome do Projeto -->
    <version>0.0.1-SNAPSHOT</version> <!-- artifactId + Version = Nome do Jar -->
    <name>rest-with-spring-boot-and-java-erudio</name> <!-- Nome Amigável - para documentação (pode ser diferente do artifactId) -->
    <description>Demo project for Spring Boot</description> <!-- Descrição do projeto - aparece em documentação e ferramentas -->

    <!-- Versões de bibliotecas -->
    <properties>
        <java.version>21</java.version> <!-- Versão do Java para compilar e executar -->
        <dozer.version>7.0.0</dozer.version> <!-- Parametrizado o Dozer version -->
        <springdoc.version>2.7.0</springdoc.version> <!-- Parametrizado o Dozer version -->
        <testcontainers.version>1.20.4</testcontainers.version> <!-- Parametrizando o TestContainers version-->
        <apache.poi.version>5.3.0</apache.poi.version>
        <commons-csv.version>1.12.0</commons-csv.version>
        <jasperreports.version>7.0.3</jasperreports.version>
        <zxing.verison>3.5.3</zxing.verison>
        <java-jwt.version>4.4.0</java-jwt.version>
    </properties>

    <dependencies>
        <!-- Aqui Adiciona-se as dependências -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId> <!-- Inclui: Tomcat, Spring MVC, JSON, etc. -->
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>   <!-- Dependencia do Spring Data JPA -->

        <dependency>
            <groupId>org.springframework.hateoas</groupId>
            <artifactId>spring-hateoas</artifactId> <!-- Dependencia do HATEOAS -->
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>   <!-- Dependencia Jackson Format xml -->

        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>   <!-- Dependencia Jackson Format yaml -->

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${apache.poi.version}</version>
        </dependency>

        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports</artifactId>
            <version>${jasperreports.version}</version>
        </dependency>

        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports-fonts</artifactId>
            <version>${jasperreports.version}</version>
        </dependency>

        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports-pdf</artifactId>
            <version>${jasperreports.version}</version>
        </dependency>

        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.verison}</version>
        </dependency>

        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>${zxing.verison}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId> <!-- Dependência do MySQL. Não especificar versão, Spring define automaticamente -->
            <scope>runtime</scope> <!-- Padrão: Disponível em todas as fases: Compilação, testes e execução. runtime: Disponivel apenas durante testes e execução. -->
        </dependency>

        <dependency>
            <groupId>com.github.dozermapper</groupId> <!-- Dependência do Dozer -->
            <artifactId>dozer-core</artifactId>
            <version>${dozer.version}</version> <!-- Valor parametrizado -->
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId> <!-- Spring Boot Test - testes automatizados -->
            <scope>test</scope>    <!-- Só usado em testes -->
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId> <!-- Spring Boot Test - testes automatizados -->
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId> <!-- Spring Boot Test - testes automatizados -->
        </dependency>

        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <version>${java-jwt.version}</version>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>  <!-- Spring Boot DevTools - recarregamento automático em desenvolvimento -->
            <scope>runtime</scope> <!-- Só disponível durante execução -->
            <optional>true</optional> <!-- Não é repassado para outros projetos -->
        </dependency>

        <dependency>
            <groupId>net.sf.barcode4j</groupId>
            <artifactId>barcode4j</artifactId>
            <version>2.1</version>
        </dependency>

        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports</artifactId>
            <version>7.0.3</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId><!-- Plugin Spring Boot - cria JAR executável -->
            </plugin>


        </plugins>
    </build>

</project>
